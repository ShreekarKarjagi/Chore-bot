# --- Twilio account credentials (from twilio.com console) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio phone number you bought for SMS (Phone Numbers > Manage > Active Numbers)
TWILIO_PHONE_NUMBER=+15551230000

# --- The 3 housemates ---
# Numbers must be in E.164 format, no spaces/dashes, no "whatsapp:" prefix
# e.g. +15551234567
PERSON_1_NAME=Alex
PERSON_1_NUMBER=+15550000001

PERSON_2_NAME=Sam
PERSON_2_NUMBER=+15550000002

PERSON_3_NAME=Jordan
PERSON_3_NUMBER=+15550000003

# --- Server ---
PORT=3000
