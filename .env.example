# --- Twilio account credentials (from twilio.com console) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp-enabled number that sends/receives messages.
# While using the free Sandbox, this is always: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- The 3 housemates ---
# Numbers must be in E.164 format prefixed with "whatsapp:"
# e.g. whatsapp:+15551234567
PERSON_1_NAME=Alex
PERSON_1_NUMBER=whatsapp:+15550000001

PERSON_2_NAME=Sam
PERSON_2_NUMBER=whatsapp:+15550000002

PERSON_3_NAME=Jordan
PERSON_3_NUMBER=whatsapp:+15550000003

# --- Server ---
PORT=3000
