# --- Textbelt ---
# Get an API key at https://textbelt.com/purchase/ (no business registration required).
TEXTBELT_API_KEY=your_textbelt_api_key_here

# Your deployed server's base URL (no trailing slash) — Textbelt sends replies here.
# e.g. https://house-chore-bot.onrender.com
WEBHOOK_BASE_URL=https://your-app-name.onrender.com

# A password of your choosing, used to protect the one-time /seed endpoint
# (e.g. https://your-app.onrender.com/seed?secret=THIS_VALUE). Make up any string.
SEED_SECRET=choose-a-random-string-here

# --- Scheduled reminders ---
# The actual weekly schedule (which day/time per chore) is hardcoded in the
# SCHEDULE object near the top of server.js — edit it there directly. This
# just sets which timezone those times are interpreted in.
TIMEZONE=America/Los_Angeles

# --- Testing (optional) ---
# When TEST_MODE is "true", every outbound text is redirected to TEST_NUMBER
# instead of its real recipient (the message notes who it would really go
# to), and /seed only messages that one number. Use this while debugging so
# you don't spend credits texting everyone else. Set TEST_MODE=false (or
# remove both vars) once you're ready to go live for real.
TEST_MODE=false
TEST_NUMBER=+15550000001

# --- The 3 housemates ---
# Numbers must be in E.164 format, no spaces/dashes
# e.g. +15551234567
PERSON_1_NAME=Alex
PERSON_1_NUMBER=+15550000001

PERSON_2_NAME=Sam
PERSON_2_NUMBER=+15550000002

PERSON_3_NAME=Jordan
PERSON_3_NUMBER=+15550000003

# --- Server ---
PORT=3000
